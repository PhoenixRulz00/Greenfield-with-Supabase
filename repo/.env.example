# Copy this file to .env.local (which is gitignored) and fill in real values.
# Find these under: Supabase Dashboard > Project Settings > API
#   https://supabase.com/dashboard/project/nejpubzkusxpmxpntpnq/settings/api

# Your project URL (safe to expose in the browser).
VITE_SUPABASE_URL=https://nejpubzkusxpmxpntpnq.supabase.co

# The "anon" / "public" key (safe to expose in the browser — Row Level
# Security policies in supabase/schema.sql do the real access control).
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# NEVER put the service_role key in this file or anywhere in frontend code.
# It bypasses Row Level Security entirely. It only belongs in the Edge
# Function's own secrets, set via:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ---------------------------------------------------------------------------
